# Скопируйте этот файл в .env и заполните настройки выбранного провайдера.
# Настоящие ключи храните только в .env, не добавляйте их в Git.

# Agnes AI
AGNES_API_KEY=
AGNES_MODEL=agnes-combo
AGNES_BASE_URL=https://omniroute.nikgretenok.online/v1

# Yandex Cloud
# Секретное значение API-ключа, полученное при создании, а не идентификатор ключа.
YANDEX_CLOUD_API_KEY=
YANDEX_CLOUD_FOLDER=
YANDEX_CLOUD_MODEL=qwen3.6-35b-a3b/latest

# Google Gemini — сейчас отключен в приложении.
GEMINI_API_KEY=

# Необязательно: папка с rus.traineddata и eng.traineddata для OCR.
# На Windows, например: C:/Program Files/Tesseract-OCR/tessdata
# TESSDATA_PREFIX=
