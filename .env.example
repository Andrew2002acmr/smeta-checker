# Скопируйте этот файл в .env и заполните настройки Yandex Cloud.
# Настоящие ключи храните только в .env, не добавляйте их в Git.

# Yandex Cloud
# Секретное значение API-ключа, полученное при создании, а не идентификатор ключа.
YANDEX_CLOUD_API_KEY=
YANDEX_CLOUD_FOLDER=
YANDEX_CLOUD_MODEL=qwen3.6-35b-a3b/latest

# Необязательно: папка с rus.traineddata и eng.traineddata для OCR.
# На Windows, например: C:/Program Files/Tesseract-OCR/tessdata
# TESSDATA_PREFIX=

# Langfuse Cloud — необязательно; пустые ключи отключают трейсинг.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Разные значения разделяют трейсы деплоев: production на main, development на dev.
LANGFUSE_ENVIRONMENT=development

# Постоянное хранение (issue 17) — необязательно; пустые значения оставляют
# результаты только в сессии Streamlit. DATABASE_URL — SQLAlchemy-URL Postgres
# (драйвер psycopg), BLOB_STORE_URL — пока только file:// (шов под S3).
#DATABASE_URL=postgresql+psycopg://smeta:secret@localhost:5432/smeta
#BLOB_STORE_URL=file://./.audit_blobs

# Base64 от "pk-lf-...:sk-lf-..." для Data MCP в .mcp.json (только .env/окружение, никогда в Git).
# Получить: echo -n "pk:sk" | base64
# LANGFUSE_MCP_AUTH_TOKEN=
