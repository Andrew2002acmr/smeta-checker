# ─── Обязательно для docker compose ─────────────────────────────
POSTGRES_PASSWORD=change-me
AUDIT_API_TOKEN=

# ─── LLM-провайдер (RouterAI, AnyModel или Yandex; без ключа аудит отвечает 503) ──
# Yandex Cloud (по умолчанию). API_KEY — секретное значение ключа.
YANDEX_CLOUD_API_KEY=
YANDEX_CLOUD_FOLDER=
#YANDEX_CLOUD_MODEL=qwen3.6-35b-a3b/latest

# AnyModel (приоритет над Yandex, когда задан). MODEL — сырой id из GET /v1/models.
#ANYMODEL_API_KEY=
#ANYMODEL_MODEL=ds/deepseek-v4-flash

# RouterAI (приоритет над AnyModel при заданном ключе или модели).
# Нужны ОБА значения; MODEL — точный id из каталога RouterAI, не AnyModel.
#ROUTERAI_API_KEY=
#ROUTERAI_MODEL=
# Строгий маршрут Decart для DeepSeek (точное имя провайдера в каталоге — Decart):
#ROUTERAI_MODEL=deepseek/deepseek-v4.1-flash-1017@provider=decart&allow_fallbacks=false
# При @provider не добавляйте provider в JSON запроса: RouterAI отклоняет дубли.
#ROUTERAI_BASE_URL=https://routerai.ru/api/v1

# ─── Вход в workspace: ровно два режима local|ldap (пусто = local) ──
# local (по умолчанию): обязательны WORKSPACE_LOGIN и WORKSPACE_PASSWORD.
#   Вход — по паре логин+пароль: логин чувствителен к регистру (пробелы по
#   краям отбрасываются), пароль сравнивается точно, без обрезки пробелов.
#   Без обоих значений вход отвечает 503, анонимного доступа нет.
# ldap: корпоративный вход Active Directory; WORKSPACE_LOGIN/WORKSPACE_PASSWORD
#   игнорируются, параметры LDAP ниже обязательны. В режиме local параметры
#   LDAP игнорируются. Автоматического fallback между режимами нет: опечатка
#   в WORKSPACE_AUTH_MODE отвечает 503, недоступность AD в режиме ldap тоже
#   отвечает 503 и никогда не откатывается на local.
# Скрипт scripts/verify-ad.mjs проверяет только режим ldap.
WORKSPACE_AUTH_MODE=
# Локальный логин (пусто = не задано; значение — произвольное, без секрета в примере).
WORKSPACE_LOGIN=
# Локальный пароль (пусто = не задан; в .env храните реальное произвольное значение).
WORKSPACE_PASSWORD=

# ─── Доступ по сети (по умолчанию — только localhost) ───────────
# Вход по логину+паролю (local) либо через AD (ldap) обязателен везде:
# localhost, интранет и интернет. Анонимного доступа нет.
# Интранет: IP или имя сервера в LAN, порт наружу на всех интерфейсах.
#NUXT_PUBLIC_HOST=192.168.1.10
#WORKSPACE_BIND=0.0.0.0
# Мировая сеть: домен + TLS-терминация выше (reverse proxy).
#NUXT_PUBLIC_HOST=audit.example.com
#WORKSPACE_BIND=0.0.0.0
#WORKSPACE_PORT=3000
#
# ─── Active Directory (выключено, пока WORKSPACE_AUTH_MODE не ldap) ───
# Не заполняйте параметры наугад; получите их у администратора AD.
# WORKSPACE_AUTH_MODE=ldap включает вход через AD вместо локальной пары
# логин+пароль; по умолчанию local.
# Точный HTTPS origin сайта, без пути (для CSRF и Secure cookie).
WORKSPACE_ORIGIN=
# В Compose задан redis://redis:6379/1; вне Docker нужен отдельный URL Redis.
WORKSPACE_REDIS_URL=
# Полный URL с явным портом: ldaps://<сервер>:<порт> либо ldap://<сервер>:<порт>.
# Пустой LDAP_TLS_MODE = безопасно по умолчанию: ldaps:// → LDAPS,
# ldap:// → обязательный STARTTLS до обоих bind.
LDAP_URL=
# Режим TLS к AD (пусто = поведение выше). Явные значения: ldaps|starttls|none.
# none — только явный opt-in для ldap:// (внутренняя сеть, как Bitrix):
# пропускает TLS перед обоими bind. starttls — только для ldap://,
# ldaps — только для ldaps://; несовпадение схемы/режима и неизвестное
# значение запрещают вход до открытия сокетов. Ошибка TLS в безопасных
# режимах никогда не откатывается в none.
LDAP_TLS_MODE=
LDAP_BASE_DN=
# Подтверждённый домен корпоративных логинов.
LDAP_DOMAIN=
# Служебная учётная запись с правом чтения пользователей/групп (только поиск).
# Живой bind успешен: CN=smeta,CN=Users,DC=kdfp,DC=ru / smeta@kdfp.ru.
# Для LDAP_ACCESS_MODE=all нужен полный DN (CN=smeta,CN=Users,DC=kdfp,DC=ru),
# не UPN/короткое имя; в group допустимы полный DN и UPN.
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
# Политика авторизации LDAP (пусто = group, по умолчанию).
# group: вход только для членов LDAP_GROUP_DN, включая вложенные группы AD;
#   LDAP_GROUP_DN обязателен. all: вход для любой активной/разблокированной/
#   неистёкшей учётной записи-пользователя в LDAP_BASE_DN, кроме служебной
#   записи поиска; роли сотрудников не выводятся, прочие служебные записи
#   с верным паролем тоже проходят. Пустой LDAP_GROUP_DN — не «все», он
#   обязателен для group и игнорируется в all.
LDAP_ACCESS_MODE=
# Полный DN разрешённой группы; учитываются вложенные группы AD.
# Обязателен только для group; в all игнорируется (оставьте пустым).
LDAP_GROUP_DN=
# Путь CA PEM внутри контейнера, пусто = системные доверенные CA.
LDAP_CA_FILE=
# Путь CA PEM на хосте; только для compose.ldap-ca.yaml (read-only mount).
LDAP_CA_HOST_FILE=

# ─── Необязательно ──────────────────────────────────────────────
# PostgreSQL и порты (значения по умолчанию ниже).
#POSTGRES_USER=smeta
#POSTGRES_DB=smeta
#API_PORT=8000

# Трейсинг Langfuse (пустые ключи = выключен).
#LANGFUSE_PUBLIC_KEY=
#LANGFUSE_SECRET_KEY=
#LANGFUSE_ENVIRONMENT=development
# При локальном Docker: внутренний LANGFUSE_BASE_URL и публичная ссылка для браузера.
#LANGFUSE_BASE_URL=http://langfuse-web:3000
#LANGFUSE_PUBLIC_URL=http://localhost:3002

# Тонкая настройка (значения по умолчанию; раскомментируйте для переопределения).
#ANYMODEL_BASE_URL=https://anymodel.org/v1
#AUDIT_ALLOWED_LLM_HOSTS=ai.api.cloud.yandex.net  # хост выбранного ANYMODEL_BASE_URL доверяется автоматически
#AUDIT_LLM_INPUT_COST_PER_1K=0
#AUDIT_LLM_OUTPUT_COST_PER_1K=0
#AUDIT_LLM_CONCURRENCY=2
#AUDIT_MAX_TASKS_PER_CHILD=50
#AUDIT_MAX_UPLOAD_BYTES=104857600
#AUDIT_MAX_UPLOADS_PER_REQUEST=32
#AUDIT_PDF_CONCURRENCY=2
#AUDIT_TASK_SOFT_TIME_LIMIT=540
#AUDIT_TASK_TIME_LIMIT=600
#AUDIT_TELEMETRY_MASK_PROMPTS=0
#AUDIT_TELEMETRY_REDACT_PDF=0
#TESSDATA_PREFIX=

# ─── Мониторинг (опционально, compose.monitoring.yaml) ─────────────
# Запуск: docker compose -f compose.yaml -f compose.monitoring.yaml up -d
#GRAFANA_ADMIN_USER=admin
#GRAFANA_ADMIN_PASSWORD=change-me
#GRAFANA_ROOT_URL=http://localhost:3001
#GRAFANA_PORT=3001
#PROMETHEUS_PORT=9090
#LOKI_PORT=3100

# ─── GlitchTip / Sentry (опционально) ───────────────────────────────
# Внешний DSN (cloud/self-hosted). Для self-hosted см. compose.glitchtip.yaml.
#GLITCHTIP_DSN=
#SENTRY_ENVIRONMENT=production
#SENTRY_RELEASE=
#SENTRY_TRACES_SAMPLE_RATE=0.05
#NUXT_PUBLIC_SENTRY_DSN=
#NUXT_PUBLIC_SENTRY_ENVIRONMENT=production
#
# Self-hosted GlitchTip (compose.glitchtip.yaml):
#GLITCHTIP_SECRET_KEY=change-me-long-random
#GLITCHTIP_DOMAIN=http://localhost:8001
#GLITCHTIP_PORT=8001
#GLITCHTIP_BIND=127.0.0.1
#GLITCHTIP_EMAIL_URL=consolemail://
#GLITCHTIP_DEFAULT_FROM_EMAIL=glitchtip@localhost
#GLITCHTIP_ENABLE_USER_REGISTRATION=true
#GLITCHTIP_ALLOWED_HOSTS=*
