# Скопируйте этот файл в .env и заполните настройки Yandex Cloud.
# Настоящие ключи храните только в .env, не добавляйте их в Git.

# Yandex Cloud
# Секретное значение API-ключа, полученное при создании, а не идентификатор ключа.
YANDEX_CLOUD_API_KEY=
YANDEX_CLOUD_FOLDER=
YANDEX_CLOUD_MODEL=qwen3.6-35b-a3b/latest

# Необязательно: папка с rus.traineddata и eng.traineddata для OCR.
# На Windows, например: C:/Program Files/Tesseract-OCR/tessdata
# TESSDATA_PREFIX=

# Langfuse Cloud — необязательно; пустые ключи отключают трейсинг.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Разные значения разделяют трейсы деплоев: production на main, development на dev.
LANGFUSE_ENVIRONMENT=development

# Постоянное хранение (issue 17) — необязательно; пустые значения оставляют
# результаты только в сессии Streamlit. DATABASE_URL — SQLAlchemy-URL Postgres
# (драйвер psycopg), BLOB_STORE_URL — пока только file:// (шов под S3).
#DATABASE_URL=postgresql+psycopg://smeta:secret@localhost:5432/smeta
#BLOB_STORE_URL=file://./.audit_blobs

# Фоновые задания (issue 19) — необязательно; без брокера API выполняет тот же
# конвейер audit_tasks в отдельном fallback-процессе. С брокером: очередь `pdf`
# для CPU/OCR-подготовки и финализации, очередь `llm` для сетевых запросов.
#CELERY_BROKER_URL=redis://localhost:6379/0
#AUDIT_PDF_CONCURRENCY=2
#AUDIT_LLM_CONCURRENCY=8
#AUDIT_TASK_TIME_LIMIT=600
#AUDIT_TASK_SOFT_TIME_LIMIT=540

# Base64 от "pk-lf-...:sk-lf-..." для Data MCP в .mcp.json (только .env/окружение, никогда в Git).
# Получить: echo -n "pk:sk" | base64
# LANGFUSE_MCP_AUTH_TOKEN=
# Observability и безопасность (issue 21) — всё необязательно, ниже значения по умолчанию.
# Телеметрия: 1 скрывает тела фрагментов ПД / тексты промптов в Langfuse, маршрутные
# ключи (страницы, счётчики, usage) остаются.
#AUDIT_TELEMETRY_REDACT_PDF=0
#AUDIT_TELEMETRY_MASK_PROMPTS=0
# Загрузки: максимальный размер одного файла в байтах и число документов на аудит.
#AUDIT_MAX_UPLOAD_BYTES=104857600
#AUDIT_MAX_UPLOADS_PER_REQUEST=32
# Токен REST API (issue 22): пустой = локальный доступ без авторизации,
# непустой = все /api/v1/* требуют Authorization: Bearer <токен>.
# Production compose требует это значение (валится без него).
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
#AUDIT_API_TOKEN=
# Разрешённые хосты LLM-эндпоинта через запятую; остальные отклоняются до HTTP.
#AUDIT_ALLOWED_LLM_HOSTS=ai.api.cloud.yandex.net
# Тарифы провайдера за 1000 токенов (валюта провайдера); нули = стоимость неизвестна.
#AUDIT_LLM_INPUT_COST_PER_1K=0
#AUDIT_LLM_OUTPUT_COST_PER_1K=0

# Production Compose (issue 22) — обязательно для compose.yaml.
#POSTGRES_USER=smeta
#POSTGRES_PASSWORD=change-me
#POSTGRES_DB=smeta
#API_PORT=8000
#UI_PORT=8501
