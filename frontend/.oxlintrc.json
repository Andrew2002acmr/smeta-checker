{
  "ignorePatterns": [
    "app/generated/**",
    "node_modules/**",
    ".nuxt/**",
    ".output/**",
    "public/**",
    ".api-check/**"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "no-unused-vars": "error",
    "no-debugger": "error"
  }
}
