{
  "ignorePatterns": [
    "app/generated/**",
    "node_modules/**",
    ".nuxt/**",
    ".output/**",
    "public/**",
    ".api-check/**"
  ],
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "promise",
    "vue",
    "vitest",
    "node"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "warn",
    "perf": "warn",
    "style": "off"
  },
  "rules": {
    "no-unused-vars": "error",
    "no-debugger": "error"
  }
}