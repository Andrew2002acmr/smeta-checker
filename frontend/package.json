{
  "name": "kdfp-audit-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build",
    "preview": "node .output/server/index.mjs",
    "typecheck": "nuxt typecheck",
    "lint": "oxlint --deny-warnings --vue-plugin --vitest-plugin",
