    "zod": "4.3.6"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@nuxt/test-utils": "4.3.4",
    "@playwright/test": "1.61.1",
    "@types/node": "^24.19.2",
    "@vue/test-utils": "2.4.6",
    "happy-dom": "^21.0.3",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "5.9.3",
    "vitest": "4.1.0",
    "vue-tsc": "3.2.6"
  },
  "packageManager": "pnpm@11.25.0"
