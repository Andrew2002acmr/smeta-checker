# Standalone observability stack: copy to .env on the server and fill secrets.
# Generate secrets on the server, never commit them:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Internal postgres/redis (GlitchTip backend only).
OBS_POSTGRES_USER=obs
OBS_POSTGRES_DB=obs
OBS_POSTGRES_PASSWORD=change-me

# Grafana admin (https://grafana.nikgretenok.online).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_ROOT_URL=https://grafana.nikgretenok.online

# GlitchTip (https://glitchtip.nikgretenok.online).
# DOMAIN must be the public URL: provisioned DSN embeds it.
GLITCHTIP_SECRET_KEY=change-me-long-random
GLITCHTIP_DOMAIN=https://glitchtip.nikgretenok.online
GLITCHTIP_EMAIL_URL=consolemail://
GLITCHTIP_DEFAULT_FROM_EMAIL=glitchtip@localhost
# Keep true for first boot (provision script needs no login anyway),
# set to false after provisioning and restart glitchtip.
GLITCHTIP_ENABLE_USER_REGISTRATION=true

# Phoenix UI (https://phoenix.nikgretenok.online) behind Traefik basic-auth;
# OTLP ingest path /v1/* stays open (see traefik/observability.yml).
PHOENIX_BASIC_USER=obs
PHOENIX_BASIC_PASSWORD=change-me
