+        <dd>{{ duration(metrics.agent_execution_duration_ms) }}</dd>
+      </div>
+      <div>
+        <dt class="muted">Запущено субагентов</dt>
+        <dd>{{ number(metrics.subagents_started) }}</dd>
+      </div>
+      <div>
+        <dt class="muted">Модель</dt>
+        <dd>{{ metrics.model || '—' }}</dd>
+      </div>
+      <div>
+        <dt class="muted">Токены ввода / вывода</dt>
