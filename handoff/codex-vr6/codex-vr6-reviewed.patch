+<script setup lang="ts">
+import type { Citation, PositionConclusion, VersionDto } from '~/generated/types.gen'
+import { codexDirections, codexStatuses } from '~/utils/codexPresentation'
+
+const props = defineProps<{
+  runId: string
+  result: PositionConclusion
+  documents: VersionDto[]
+}>()
+const emit = defineEmits<{ projectSource: [documentId: string, page: number] }>()
+const backend = useBackend()
+
+function citationTitle(source: Citation) {
+  const name = props.documents.find((document) => document.id === source.document_id)?.filename
+  if (source.kind === 'vor') return `${name ?? 'ВОР'} · ${source.sheet} · строка ${source.row}`
+  return `${name ?? (source.kind === 'normative' ? 'Нормативный документ' : 'ПД')} · стр. ${source.page}`
+}
+
+function citationUrl(source: Citation) {
+  if (source.kind === 'normative')
+    return `${backend.audit(props.runId)}/codex-sources/${encodeURIComponent(source.document_id)}#page=${source.page}`
+  return `${backend.contentUrl(source.document_id)}?download=true`
+}
+</script>
+
+<template>
+  <section
+    aria-label="Направления проверки Codex"
+    class="grid min-w-0 gap-3 [overflow-wrap:anywhere]"
+  >
+    <p class="muted">Конструкция или группа работ · {{ result.group }}</p>
+    <UCard v-for="{ key, label } in codexDirections" :key="key" class="min-w-0">
+      <div class="grid min-w-0 gap-3">
+        <div class="flex flex-wrap items-center gap-2">
+          <h2 class="font-semibold">{{ label }}</h2>
+          <UBadge
+            :label="codexStatuses[result[key].status].label"
+            :color="codexStatuses[result[key].status].color"
+            variant="soft"
+          />
+        </div>
+        <p class="muted">{{ result[key].parameter }}</p>
+        <p>{{ result[key].conclusion }}</p>
+        <dl class="grid gap-1 text-sm">
+          <div v-if="result[key].vor_value" class="flex flex-wrap gap-x-2">
+            <dt class="muted">ВОР</dt>
+            <dd>{{ result[key].vor_value }} {{ result[key].unit }}</dd>
+          </div>
+          <div v-if="result[key].source_value" class="flex flex-wrap gap-x-2">
+            <dt class="muted">По источнику</dt>
+            <dd>{{ result[key].source_value }} {{ result[key].unit }}</dd>
+          </div>
+          <div v-if="result[key].calculation" class="flex flex-wrap gap-x-2">
+            <dt class="muted">Расчёт</dt>
+            <dd>
+              {{ result[key].calculation.expression }} = {{ result[key].calculation.result }}
+              {{ result[key].unit }}
+            </dd>
+          </div>
+          <div v-if="result[key].deviation" class="flex flex-wrap gap-x-2">
+            <dt class="muted">Отклонение от ВОР</dt>
+            <dd>{{ result[key].deviation }} {{ result[key].unit }}</dd>
+          </div>
+        </dl>
+        <div v-if="result[key].missing_facts" class="grid gap-1 border-l-2 border-warning pl-3">
+          <p><strong>Требуется</strong> {{ result[key].missing_facts.required }}</p>
+          <p><strong>Почему</strong> {{ result[key].missing_facts.reason }}</p>
+          <p><strong>Уже установлено</strong> {{ result[key].missing_facts.established }}</p>
+        </div>
+        <ul v-if="result[key].sources.length" class="grid gap-2 border-t border-default pt-2">
+          <li v-for="(source, index) in result[key].sources" :key="index">
+            <UButton
+              v-if="source.kind === 'project' && source.page !== null"
+              :label="citationTitle(source)"
+              variant="link"
+              icon="i-lucide-file-text"
+              class="max-w-full whitespace-normal text-left"
+              @click="emit('projectSource', source.document_id, source.page)"
+            />
+            <UButton
+              v-else
+              :label="citationTitle(source)"
+              :to="citationUrl(source)"
+              target="_blank"
+              rel="noopener"
+              variant="link"
+              icon="i-lucide-file-text"
+              class="max-w-full whitespace-normal text-left"
+              external
+            />
+            <blockquote class="muted pl-3 text-sm">{{ source.quote }}</blockquote>
+          </li>
+        </ul>
+      </div>
+    </UCard>
+  </section>
+</template>
