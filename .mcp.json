{
  "mcpServers": {
    "agent-browser": {
      "command": "agent-browser",
      "args": ["mcp", "--tools", "core"],
      "env": {
        "AGENT_BROWSER_SESSION": "smeta-check"
      }
    },
    "phoenix": {
      "type": "http",
      "url": "${PHOENIX_MCP_URL:-http://localhost:6006/mcp}"
    },
    "glitchtip": {
      "type": "http",
      "url": "${GLITCHTIP_MCP_URL:-http://localhost:8001/mcp}"
    },
    "figma-console": {
      "command": "npx",
      "args": ["-y", "figma-console-mcp@latest"],
      "env": {
        "FIGMA_ACCESS_TOKEN": "${FIGMA_ACCESS_TOKEN}",
        "ENABLE_MCP_APPS": "true"
      }
    },
    "nuxt-ui": {
      "type": "http",
      "url": "https://ui.nuxt.com/mcp"
    }
  }
}